---
// src/pages/careers.astro
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import '../styles/careers.css';

const values = [
  { title: 'Reliability First', desc: 'Systems that never fail when it matters most. We build for zero-downtime operations.' },
  { title: 'Performance Obsession', desc: 'Sub-second responses aren\'t optional—they\'re the baseline. We optimize relentlessly.' },
  { title: 'Craft Excellence', desc: 'Apple-grade attention to detail in every pixel, interaction, and line of code.' },
  { title: 'Direct Impact', desc: 'Your work affects millions. No ivory tower architecture—just real systems, real users.' }
];

const openings = [
  { 
    title: 'Forward Deployed Engineer', 
    type: 'Full-time',
    location: 'Fully Remote',
    desc: 'Bridge the gap between complex engineering and real-world deployment. You will work directly with clients to integrate our systems, solve on-the-ground technical challenges, and ensure flawless execution.',
    requirements: [
      '3+ years in software engineering or technical consulting',
      'Exceptional problem-solving and client-facing communication skills',
      'Experience with cloud infrastructure, CI/CD, and system architecture',
      'Willingness to travel and work directly with enterprise teams'
    ]
  },
  { 
    title: 'Senior Backend Engineer', 
    type: 'Full-time',
    location: 'Hybrid (Nairobi / Remote)',
    desc: 'Architect and scale our mission-critical systems. You\'ll design the infrastructure that handles thousands of transactions per second with absolute reliability.',
    requirements: [
      '5+ years building production backend systems',
      'Deep expertise in Node.js, Go, or Rust',
      'Experience with distributed systems and microservices',
      'Understanding of offline-first architectures'
    ]
  },
  { 
    title: 'Frontend Engineer (Mobile Focus)', 
    type: 'Full-time',
    location: 'Fully Remote',
    desc: 'Build fluid, 60fps mobile applications that feel like native experiences. You\'ll work directly with hardware integration and complex state management.',
    requirements: [
      '3+ years building mobile applications',
      'Expertise in React Native or Flutter',
      'Experience with Bluetooth LE and hardware integration',
      'Understanding of mobile performance optimization'
    ]
  },
  { 
    title: 'Systems Engineer', 
    type: 'Full-time',
    location: 'Hybrid (Nairobi)',
    desc: 'Design and implement our POS architectures. You\'ll work on embedded systems, thermal printers, barcode scanners, and retail hardware ecosystems.',
    requirements: [
      '3+ years in systems or embedded engineering',
      'Experience with retail POS systems',
      'Knowledge of hardware communication protocols',
      'Understanding of offline transaction queues'
    ]
  }
];
---

<Layout title="Careers | DevGrid Innovations">
  
  <!-- 1. Hero Section -->
  <section class="careers-hero">
    <div class="section-container">
      <span class="careers-eyebrow" data-reveal>Join Our Team</span>
      <h1 class="careers-title" data-reveal style="--delay: 0.1s">Build the future of enterprise technology</h1>
      <p class="careers-subtitle" data-reveal style="--delay: 0.2s">
        We're looking for engineers who demand excellence. No bureaucracy, just world-class engineering.
      </p>
      <div class="careers-stats" data-reveal style="--delay: 0.3s">
        <div class="stat">
          <span class="stat-number">12</span>
          <span class="stat-label">Elite Engineers</span>
        </div>
        <div class="stat">
          <span class="stat-number">0</span>
          <span class="stat-label">Bureaucracy</span>
        </div>
        <div class="stat">
          <span class="stat-number">∞</span>
          <span class="stat-label">Learning</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Engineering Principles -->
  <section class="careers-values">
    <div class="section-container">
      <h2 class="section-heading" data-reveal>Our engineering principles</h2>
      <div class="careers-values-grid">
        {values.map((item, index) => (
          <div class="careers-value-item" data-reveal style={`--delay: ${index * 0.1}s`}>
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. Open Positions -->
  <section class="careers-openings">
    <div class="section-container">
      <div class="careers-openings-header" data-reveal>
        <h2 class="section-heading" style="margin-bottom: 16px;">Open positions</h2>
        <p class="careers-openings-subtitle">We offer flexible, high-trust environments tailored to the role.</p>
      </div>

      <div class="careers-openings-list">
        {openings.map((job, index) => (
          <div class="careers-opening" data-reveal style={`--delay: ${index * 0.1}s`}>
            <div class="careers-opening-header">
              <h3>{job.title}</h3>
              <div class="careers-opening-meta">
                <span class="careers-opening-type">{job.type}</span>
                <span class="careers-opening-location">{job.location}</span>
              </div>
            </div>
            <p class="careers-opening-desc">{job.desc}</p>
            <ul class="careers-opening-requirements">
              {job.requirements.map(req => (
                <li>{req}</li>
              ))}
            </ul>
            <a href="/get-started" class="careers-opening-cta">Apply now →</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. Final CTA -->
  <section class="careers-cta">
    <div class="section-container">
      <div class="careers-cta-container" data-reveal>
        <h2>Don't see a perfect fit?</h2>
        <p>We're always looking for exceptional talent. Send us your resume and let's build something extraordinary.</p>
        <a href="mailto:careers@devgrid.agency" class="careers-cta-btn">General Application</a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>