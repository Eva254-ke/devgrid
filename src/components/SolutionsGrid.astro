---
// src/components/SolutionsGrid.astro
import '../styles/solutions-grid.css';

const capabilities = [
  {
    num: '01',
    title: 'Offline-First Resilience',
    description: 'Systems designed to perform uninterrupted in remote environments or low-connectivity zones, ensuring zero data loss during network outages.'
  },
  {
    num: '02',
    title: 'Sub-Second Speeds',
    description: 'Lightweight architectures optimized for fast load times and instant screen updates to convert and retain active platform users.'
  },
  {
    num: '03',
    title: 'Hardware Interoperability',
    description: 'Direct integration with physical peripherals—thermal printers, barcode scanners, and custom sensor setups without third-party middleware.'
  },
  {
    num: '04',
    title: 'Embedded On-Device Intelligence',
    description: 'Local machine learning models integrated directly onto client devices for real-time diagnostic intelligence without server latency.'
  },
  {
    num: '05',
    title: 'Cross-Platform Unification',
    description: 'Single codebase maintenance delivering identical feature parity, design precision, and responsiveness across web, iOS, and Android.'
  },
  {
    num: '06',
    title: 'Enterprise Security Standards',
    description: 'Role-based access controls, encrypted data stores, and audited transaction logs to protect company assets and operational data.'
  }
];
---

<section class="solutions-section">
  <div class="solutions-container">
    
    <div class="solutions-header" data-reveal>
      <span class="solutions-eyebrow">Architectural Guarantees</span>
      <h2 class="solutions-title">Engineered for Reliability</h2>
      <p class="solutions-subtitle">
        We select the right tools for the job so your business gets fast, stable, and scalable solutions.
      </p>
    </div>

    <div class="solutions-grid">
      {capabilities.map((item, index) => (
        <div class="solution-item" data-reveal style={`--delay: ${index * 0.1}s`}>
          <span class="solution-number">{item.num}</span>
          <h3>{item.title}</h3>
          <p>{item.description}</p>
        </div>
      ))}
    </div>

  </div>
</section>

<script>
  // Lightweight, performant scroll reveal
  const revealElements = document.querySelectorAll('.solutions-section [data-reveal]');
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });

  revealElements.forEach((el) => observer.observe(el));
</script>