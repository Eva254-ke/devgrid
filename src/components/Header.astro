---
// src/components/Header.astro
const navItems = [
  { name: 'About', href: '/about' },
  { name: 'Startups', href: '/startups' },
  { name: 'Enterprise', href: '/enterprise' },
  { name: 'Agency Workflow', href: '#workflow' },
];
---

<header class="apple-header" id="apple-header">
  <div class="header-inner">
    <!-- Brand Logo -->
    <a href="/" class="brand-link hover-effect">
      <img src="/logo.jpeg" alt="DevGrid" class="brand-logo" />
      <div class="brand-text">
        <span>DevGrid</span>
        <span class="brand-badge">Innovations</span>
      </div>
    </a>

    <!-- Center Navigation Links (Desktop) -->
    <nav class="desktop-nav">
      <ul class="nav-list">
        {navItems.map((item) => (
          <li>
            <a href={item.href} class="nav-link hover-effect">{item.name}</a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Right Side Actions (Desktop) -->
    <div class="header-actions">
      <button class="search-trigger hover-effect" id="open-search-btn" aria-label="Search site">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <span>Search</span>
        <kbd class="kbd-shortcut">⌘K</kbd>
      </button>
      
      <!-- Primary Conversion CTA -->
      <a href="/get-started" class="header-cta-btn hover-effect">Get started</a>
    </div>

    <!-- Mobile Menu Toggle (Hamburger) -->
    <button class="mobile-menu-toggle" id="mobile-menu-toggle" aria-label="Toggle navigation menu" aria-expanded="false">
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
    </button>
  </div>

  <!-- Mobile Navigation Overlay -->
  <nav class="mobile-nav" id="mobile-nav" aria-label="Mobile navigation">
    <div class="mobile-nav-inner">
      {navItems.map((item) => (
        <a href={item.href} class="mobile-nav-link">{item.name}</a>
      ))}
      
      <div class="mobile-nav-divider"></div>
      
      <!-- Primary Conversion CTA (Mobile) -->
      <a href="/get-started" class="mobile-cta-btn hover-effect">Get started</a>
    </div>
  </nav>
</header>

<script>
  // Mobile Menu Logic
  const header = document.getElementById('apple-header');
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  
  if (toggleBtn) {
    toggleBtn.addEventListener('click', () => {
      const isOpen = header.classList.toggle('is-open');
      toggleBtn.setAttribute('aria-expanded', isOpen);
      document.body.classList.toggle('menu-open', isOpen);
    });

    // Auto-close menu when a link is clicked
    const mobileLinks = header.querySelectorAll('.mobile-nav-link, .mobile-cta-btn');
    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        header.classList.remove('is-open');
        toggleBtn.setAttribute('aria-expanded', 'false');
        document.body.classList.remove('menu-open');
      });
    });
  }
</script>