---
// src/components/LazySection.astro
// Premium lazy loading component with smooth entrance animations
const { children, className = "", delay = 0 } = Astro.props;
---

<section class={`lazy-section ${className}`} data-reveal style={`--delay: ${delay}s`}>
  {children}
</section>

<style>
.lazy-section {
  opacity: 0;
  transform: translateY(40px);
  transition: opacity 1s cubic-bezier(0.16, 1, 0.3, 1), transform 1s cubic-bezier(0.16, 1, 0.3, 1);
  transition-delay: var(--delay, 0s);
  will-change: opacity, transform;
}

.lazy-section.is-visible {
  opacity: 1;
  transform: translateY(0);
}
</style>
