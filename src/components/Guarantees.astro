---
// src/components/Guarantees.astro
import '../styles/guarantees.css';

const guarantees = [
  {
    title: 'Offline-First Resilience',
    description: 'Systems designed to perform uninterrupted in remote environments or low-connectivity zones.',
    number: '01'
  },
  {
    title: 'Sub-Second Speeds',
    description: 'Lightweight architectures optimized for fast load times and instant screen updates.',
    number: '02'
  },
  {
    title: 'Hardware Interoperability',
    description: 'Direct integration with physical peripherals without third-party middleware.',
    number: '03'
  },
  {
    title: 'On-Device Intelligence',
    description: 'Local machine learning models integrated directly onto client devices for real-time diagnostics.',
    number: '04'
  },
  {
    title: 'Cross-Platform Unification',
    description: 'Single codebase maintenance delivering identical feature parity across web, iOS, and Android.',
    number: '05'
  },
  {
    title: 'Enterprise Security',
    description: 'Role-based access controls, encrypted data stores, and audited transaction logs.',
    number: '06'
  }
];
---

<section id="guarantees" class="guarantees-section" data-reveal>
  <div class="guarantees-container">
    <div class="guarantees-header" data-reveal>
      <span class="guarantees-eyebrow">Architectural Guarantees</span>
      <h2 class="guarantees-title">Engineered for Reliability</h2>
      <p class="guarantees-subtitle">We select the right tools for the job so your business gets fast, stable, and scalable solutions.</p>
    </div>

    <div class="guarantees-grid">
      {guarantees.map((guarantee, index) => (
        <div class="guarantee-item" data-reveal style={`--delay: ${index * 0.05}s`}>
          <span class="guarantee-number">{guarantee.number}</span>
          <h3>{guarantee.title}</h3>
          <p>{guarantee.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
