---
// src/components/ScrollReveal.astro
// Reusable scroll reveal component for premium animations
const { children, className = "", delay = 0, threshold = 0.1 } = Astro.props;
---

<div class={`scroll-reveal ${className}`} data-reveal style={`--delay: ${delay}s`} data-threshold={threshold}>
  {children}
</div>

<style>
.scroll-reveal {
  opacity: 0;
  transform: translateY(32px);
  transition: opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1), transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
  transition-delay: var(--delay, 0s);
  will-change: opacity, transform;
}

.scroll-reveal.is-visible {
  opacity: 1;
  transform: translateY(0);
}
</style>
