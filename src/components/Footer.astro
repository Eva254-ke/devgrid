---
// src/components/Footer.astro
import '../styles/footer.css';

const currentYear = new Date().getFullYear();
---

<footer id="contact" class="footer-section" data-reveal>
  <div class="footer-container">
    
    <!-- Call to Action Box -->
    <div class="footer-cta" data-reveal>
      <h2>Ready to build your next system?</h2>
      <p>Consult with our lead engineers to map out your architecture, timeline, and deployment specifications.</p>
      <a href="mailto:contact@devgrid.agency" class="btn-primary btn-glow">Schedule a Technical Consultation</a>
    </div>

    <!-- Sitemap Navigation -->
    <div class="footer-nav-grid" data-reveal>
      <div class="footer-col">
        <h4>Core Systems</h4>
        <ul>
          <li><a href="#systems">Web Platforms</a></li>
          <li><a href="#systems">Mobile Applications</a></li>
          <li><a href="#systems">POS Architectures</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4>Capabilities</h4>
        <ul>
          <li><a href="#workflow">Engineering Process</a></li>
          <li><a href="#apps">Case Studies</a></li>
          <li><a href="/careers">Careers</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4>Company</h4>
        <ul>
          <li><span class="footer-text">DevGrid Innovations</span></li>
          <li><span class="footer-text">Registered Software Agency</span></li>
          <li><span class="footer-text">Thika, Kenya</span></li>
        </ul>
      </div>
    </div>

    <!-- Copyright & Legal -->
    <div class="footer-bottom" data-reveal>
      <p>&copy; {currentYear} DevGrid Innovations. All rights reserved.</p>
      <p>Designed with Apple HIG & High-Performance Principles.</p>
    </div>
    
  </div>
</footer>