---
// src/components/Hero.astro
import '../styles/hero.css';
---

<section class="hero-section" data-reveal>
  <!-- Eyebrow Tagline -->
  <span class="hero-eyebrow" data-reveal style="--delay: 0s">Engineering Certainty</span>

  <!-- Main Headline -->
  <h1 class="hero-title" data-reveal style="--delay: 0.1s">
    Intelligent solutions <br class="hidden-mobile" />
    <span class="hero-gradient-text">you can trust.</span>
  </h1>

  <!-- Outcome-Driven Subtitle -->
  <p class="hero-subtitle" data-reveal style="--delay: 0.2s">
    Enterprise web platforms, native mobile applications, and business POS architectures—engineered for sub-second speed, offline resilience, and absolute operational reliability.
  </p>

  <!-- Containerless Call to Action -->
  <div class="hero-actions" data-reveal style="--delay: 0.3s">
    <a href="#contact" class="hero-btn-primary btn-glow">
      Consult an Engineer
    </a>
    <a href="#systems" class="hero-btn-secondary">
      Explore Core Systems
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </a>
  </div>
</section>