---
// src/components/Hero.astro
import '../styles/hero.css';
---

<section class="hero-section">
  <div class="hero-inner">
    
    <!-- Eyebrow: Simple, confident category label -->
    <span class="hero-eyebrow" data-reveal style="--delay: 0s">Software Engineering</span>

    <!-- Main Headline: Kept exactly as requested -->
    <h1 class="hero-title" data-reveal style="--delay: 0.1s">
      Intelligent solutions <br class="hidden-mobile" />
      <span class="hero-gradient-text">you can trust.</span>
    </h1>

    <!-- Subtitle: Refined for premium, inclusive tone (startups + enterprises) -->
    <p class="hero-subtitle" data-reveal style="--delay: 0.2s">
      Software engineering for startups and enterprises. Let's discuss how we can help you accelerate your business.
    </p>

    <!-- Call to Action: "Partner with Us" implies a strategic team relationship -->
    <div class="hero-actions" data-reveal style="--delay: 0.3s">
      <a href="/get-started" class="hero-btn-primary btn-glow">
        Partner with Us
      </a>
      <a href="#systems" class="hero-btn-secondary">
        Explore Capabilities
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </a>
    </div>

  </div>
</section>