---
// src/layouts/Layout.astro
import '../styles/styles.css'; // Ensure this matches your actual global CSS filename
import Header from '../components/Header.astro';

// Define props with default fallbacks for SEO
const { 
  title = "DevGrid Innovations | Enterprise Software Engineering", 
  description = "DevGrid Innovations partners with startups and enterprises to build high-performance, scalable, and secure web platforms, mobile applications, and POS systems." 
} = Astro.props;

// Construct the canonical URL dynamically
const canonicalURL = new URL(Astro.url.pathname, "https://devgridsystems.com").href;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Core SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Favicon -->
    <link rel="icon" type="image/jpeg" href="/logo.jpeg" />
    
    <!-- Open Graph / Social Media Meta Tags -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content="https://devgridsystems.com/og-image.jpg" /> <!-- Add an og-image.jpg to your public folder later -->
    
    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    
    <!-- Global Scripts (Must be placed in the `public/scripts/` folder, NOT `src/`) -->
    <script src="/scripts/scrollObserver.js" type="module"></script>
  </body>
</html>